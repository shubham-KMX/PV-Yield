# Google Maps API key (Geocoding + Static Maps enabled, billing active).
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Comma-separated allowed frontend origins (CORS).
# Production: set to your Vercel URL, e.g. https://pv-yield.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Data-source toggles (mock vs live). All should be false in production.
USE_MOCK_GEOCODING=false
USE_MOCK_IMAGERY=false
USE_MOCK_WEATHER=false
